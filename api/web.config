<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════════════
   IIS hosting — ไฟล์นี้ถูกคัดลอกไปกับ `dotnet publish` ตามที่ตั้งไว้ใน csproj
   (<IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>)
   ถ้าไม่ตั้ง SDK จะ "สร้างทับ" ทุกครั้งที่ publish แล้วทุกอย่างที่แก้ที่นี่หายหมด

   ⚠️ ห้ามใส่ความลับในไฟล์นี้เด็ดขาด — มันขึ้น git
      รหัสผ่านฐานข้อมูล / Jwt:Key ตั้งที่ "Application Pool" ของ IIS แทน
      ซึ่งเก็บใน applicationHost.config และ "อยู่รอดข้าม deploy" ด้วย:

        %windir%\system32\inetsrv\appcmd.exe set config -section:applicationPools ^
          /+"[name='<ชื่อ pool>'].environmentVariables.[name='Jwt__Key',value='<คีย์>']" ^
          /commit:apphost

      ค่าจาก app pool กับที่นี่รวมกัน ไม่ทับกัน (คนละที่เก็บ)

   ⚠️ App Pool ต้องเป็น 64-bit — Enable 32-Bit Applications = False
      YDotNet แพ็ก native มาแค่ win-x64 / win-arm64 ไม่มี win-x86
      ถ้าเป็น 32-bit จะโหลด yrs.dll ไม่ขึ้น แล้ว append_content (รวมผังงาน
      mermaid) พังตอน runtime ส่วนอย่างอื่นทำงานปกติ — หาสาเหตุยากมาก

   ⚠️ ต้องมี AspNetCoreModuleV2 บนเครื่อง (มากับ ASP.NET Core Hosting Bundle
      เวอร์ชันไหนก็ได้) ไม่งั้นได้ 500.19 หรือ 502.5
      **ตัว .NET runtime ไม่ต้องลง** ถ้า publish แบบ self-contained ด้วย
      scripts\publish-iis.ps1 — runtime ถูกแพ็กไปกับแอปแล้ว
  ═══════════════════════════════════════════════════════════════════════════
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        stdoutLogEnabled="true" ไว้ก่อนตอน deploy ครั้งแรก

        ถ้า start ไม่ขึ้นจะได้หน้า 500.30 ที่ไม่บอกอะไรเลย log ที่นี่คือที่เดียว
        ที่บอกว่า throw เพราะอะไร (เช่น Jwt:Key ว่าง หรือต่อฐานไม่ได้)

        ⚠️ ต้องสร้างโฟลเดอร์ logs\ เองและให้ app pool identity เขียนได้
           ไม่งั้นไม่มีไฟล์ออกมาเลย — แล้วจะเข้าใจผิดว่า "ไม่มี error"
        เสร็จแล้วเปลี่ยนกลับเป็น false (ไฟล์โตเรื่อย ๆ ไม่มีการหมุน)
      -->
      <!--
        ⚠️ processPath ชี้ไปที่ .exe ของแอปเอง ไม่ใช่ "dotnet"

           "dotnet" ต้องพึ่ง .NET runtime ที่ติดตั้งบนเครื่อง ถ้าเวอร์ชันไม่ตรงจะได้
           500.31 (Failed to load ASP.NET Core runtime) — ซึ่งเจอมาแล้วบนเครื่องจริง
           ที่มีแต่ .NET 8/9 ของระบบอื่น

           .exe ใช้ได้ทั้งสองแบบ: self-contained (แพ็ก runtime มาด้วย ไม่ต้องลงอะไร)
           และ framework-dependent (ถ้าเครื่องมี runtime ตรงเวอร์ชัน)

        ⚠️ hostingModel="inprocess" ใช้กับ self-contained ได้ (ยืนยันจาก web.config
           ที่ SDK generate ให้เอง) — ไม่ต้องเปลี่ยนเป็น outofprocess
      -->
      <aspNetCore processPath=".\ProjectManagementAPI.exe"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">

        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

          <!--
            ⚠️ ค่า default ใน appsettings.json คือ /app/uploads ซึ่งเป็น path ของ
               Linux (มาจาก docker) บน Windows ต้องเปลี่ยนเป็น path จริง
               และให้ app pool identity มีสิทธิ์ "Modify" ที่โฟลเดอร์นี้
          -->
          <environmentVariable name="Uploads__RootPath" value="D:\pm-data\uploads" />

          <!--
            origin ของเว็บ — ต้องเป็น scheme + host (+ port) เท่านั้น ห้ามมี path
            และห้ามมี / ปิดท้าย

            ⚠️ ปล่อยว่างไม่ได้ API จะ throw ตั้งแต่ start (CorsConfiguration)
               และใช้ * ไม่ได้ เพราะ AllowAnyOrigin() + AllowCredentials() ที่
               SignalR ต้องมี อยู่ด้วยกันไม่ได้

            ถ้า SPA กับ API อยู่โดเมนเดียวกัน (IIS proxy ให้) CORS จะไม่ทำงานเลย
            แต่ยังต้องมีค่านี้อยู่ดี
          -->
          <environmentVariable name="Cors__AllowedOrigins__0" value="https://service.bevproasia.com" />

          <!--
            ═══════════════════════════════════════════════════════════════
             สองตัวข้างล่างนี้ "ไม่ได้ตั้งที่นี่" เพราะเป็นความลับ
             ตั้งที่ Application Pool ด้วย appcmd (ดูหัวไฟล์)

               ConnectionStrings__DefaultConnection
               Jwt__Key

             ทั้งคู่ไม่มีค่า = API start ไม่ขึ้น พร้อมข้อความบอกสาเหตุใน
             logs\stdout*.log
            ═══════════════════════════════════════════════════════════════
          -->
        </environmentVariables>

      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
