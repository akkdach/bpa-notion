<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProjectManagementAPI</RootNamespace>
    <!-- warning เป็น error: nullable ที่หลุดคือ NullReferenceException ที่รอเกิดใน production -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- ─────────────────────────────────────────────────────────────────
         Secret Manager (dev เท่านั้น)

         ค่าลับตอน dev (password ของ postgres, JWT key) เก็บนอก repo ที่
         %APPDATA%\Microsoft\UserSecrets\<id>\secrets.json — ไม่ใช่ในไฟล์
         appsettings.Development.json ที่ถูก commit

         .NET โหลด store นี้ให้อัตโนมัติ "เฉพาะเมื่อ ASPNETCORE_ENVIRONMENT
         = Development" เท่านั้น → production ไม่มีทางอ่านค่าจากตรงนี้

         ตั้งค่าครั้งแรก:  pwsh scripts/setup-secrets.ps1
         ───────────────────────────────────────────────────────────────── -->
    <UserSecretsId>37957321-79d0-4c97-b2e0-f24676db57c7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- ─── ASP.NET Core ─────────────────────────────────────────────── -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />

    <!-- ─── EF Core + PostgreSQL ─────────────────────────────────────── -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- ─── Realtime ─────────────────────────────────────────────────────
         SignalR server เองอยู่ใน framework แล้ว — ที่ต้องเพิ่มคือ MessagePack
         protocol เพื่อให้ byte[] ของ Yjs ส่งเป็น binary ตรง ๆ ไม่ใช่ base64
         ใน JSON (ประหยัด ~33% บน hot path)                                -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.10" />

    <!-- ─── Auth / validation ────────────────────────────────────────── -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- ─────────────────────────────────────────────────────────────────
         SQL ที่ EF migrations เขียนไม่ได้ (partial index, GIN, PGroonga,
         CHECK constraint, generated column)

         ฝังเป็น embedded resource ไม่ใช่อ่านจาก disk เพราะ container ไม่ได้
         copy ไฟล์ .sql ไปด้วย และ path ตอน `dotnet ef` ต่างจากตอน runtime
         ───────────────────────────────────────────────────────────────── -->
    <EmbeddedResource Include="Data\Migrations\Sql\*.sql" />
  </ItemGroup>

</Project>
