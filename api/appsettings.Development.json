{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "//": "ค่าสำหรับ `dotnet run` บนเครื่อง โดยชี้ไปที่ postgres ใน docker-compose",
  "//dev-only": "ค่าเหล่านี้ใช้ได้เฉพาะ dev — production อ่านจาก env ทั้งหมด",
  "//port": "5433 ไม่ใช่ 5432 — ดู POSTGRES_HOST_PORT ใน .env.example (กันชนกับ PostgreSQL ของเครื่อง)",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=projectmanagement;Username=postgres;Password=change_me_in_env;Include Error Detail=true"
  },
  "Jwt": {
    "Key": "dev_only_secret_please_replace_with_48_random_bytes_min",
    "Issuer": "ProjectManagementAPI",
    "ExpiresIn": "24h",
    "RefreshExpiresIn": "30d"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost",
      "http://localhost:5173"
    ]
  },
  "Uploads": {
    "RootPath": "./uploads"
  }
}
