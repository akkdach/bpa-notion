# ═══════════════════════════════════════════════════════════════════════════
#  คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — .env ไม่ถูก commit
#      cp .env.example .env
#
#  ไฟล์นี้คือค่าที่ docker compose อ่าน
#
#  ถ้าจะรัน api นอก Docker (`dotnet run` / `dotnet ef`) ให้ sync ความลับเข้า
#  .NET User Secrets ก่อน — ครั้งเดียวจบ และรันซ้ำได้ทุกครั้งที่แก้ค่าข้างล่าง:
#
#      pwsh scripts/setup-secrets.ps1        (Windows)
#      bash scripts/setup-secrets.sh         (macOS / Linux)
# ═══════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=projectmanagement
POSTGRES_USER=postgres
# ⚠️ เปลี่ยนค่านี้ก่อน deploy จริง
POSTGRES_PASSWORD=change_me_in_env

# port บนเครื่อง host ที่ map เข้า postgres ใน container
#
# ไม่ใช้ 5432 เพราะเครื่อง dev มักมี PostgreSQL ของตัวเองอยู่แล้ว และไม่ใช้ 5433
# เพราะเป็น port ที่ compose project อื่นเลือกเป็น "postgres ตัวที่สอง" กันบ่อย
# (บนเครื่องที่ตั้งค่านี้ ทั้ง 5432 และ 5433 ถูกใช้อยู่แล้วทั้งคู่)
#
# ถ้าขึ้น "port is already allocated" ให้เปลี่ยนเลขนี้ — ไม่กระทบอย่างอื่น
# เพราะ api คุยกับ postgres ผ่าน network ภายในชื่อ `postgres:5432` เสมอ
POSTGRES_HOST_PORT=5440

# ─── API ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────
#  ⚠️ รหัสของบัญชีที่ API ใช้ต่อฐาน — ไม่ใช่ POSTGRES_PASSWORD ข้างบน
#
#  API ต่อด้วย role `pm_app` ซึ่งไม่ใช่ owner และไม่มี BYPASSRLS เพราะ RLS
#  ไม่มีผลกับ superuser เลย — ถ้าใส่บัญชี postgres ให้ API ทุก policy จะถูกข้าม
#  โดยไม่มีอาการอะไรให้เห็น จนกว่าจะมีลูกค้าที่สอง
#
#  role นี้ถูกสร้าง/ปรับรหัสให้ตรงกับค่านี้โดย `npm run db:setup` ใน server/
# ─────────────────────────────────────────────────────────────────────────
APP_DB_PASSWORD=change_me_app_password

# ⚠️ ต้องยาว >= 32 ตัวอักษร (HMAC-SHA256 key)
#    สร้างใหม่:  openssl rand -base64 48
JWT_SECRET=dev_only_secret_please_replace_with_48_random_bytes_min
JWT_ISSUER=ProjectManagementAPI
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# origin ที่เบราว์เซอร์ใช้เปิดแอป — ต้องตรงเป๊ะ (มี scheme, ไม่มี / ปิดท้าย)
WEB_ORIGIN=http://localhost

# ─── Web (build-time — ค่าเหล่านี้ถูกฝังลง bundle ห้ามใส่ความลับ) ──────────
# ค่า default เป็น path แบบ same-origin เพราะ nginx proxy /api และ /hubs
# ไปที่ api ให้แล้ว → ไม่มี CORS, cookie เป็น SameSite=Strict ได้
VITE_API_BASE_URL=/api/v1
VITE_HUB_URL=/hubs/doc
