# ═══════════════════════════════════════════════════════════════════════════
#  คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — .env ไม่ถูก commit
#      cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=projectmanagement
POSTGRES_USER=postgres
# ⚠️ เปลี่ยนค่านี้ก่อน deploy จริง
POSTGRES_PASSWORD=change_me_in_env

# port บนเครื่อง host ที่ map เข้า postgres ใน container
# default เป็น 5433 เพราะเครื่อง dev มักมี PostgreSQL ของตัวเองอยู่บน 5432 แล้ว
POSTGRES_HOST_PORT=5433

# ─── API ───────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ⚠️ ต้องยาว >= 32 ตัวอักษร (HMAC-SHA256 key)
#    สร้างใหม่:  openssl rand -base64 48
JWT_SECRET=dev_only_secret_please_replace_with_48_random_bytes_min
JWT_ISSUER=ProjectManagementAPI
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# origin ที่เบราว์เซอร์ใช้เปิดแอป — ต้องตรงเป๊ะ (มี scheme, ไม่มี / ปิดท้าย)
WEB_ORIGIN=http://localhost

# ─── Web (build-time — ค่าเหล่านี้ถูกฝังลง bundle ห้ามใส่ความลับ) ──────────
# ค่า default เป็น path แบบ same-origin เพราะ nginx proxy /api และ /hubs
# ไปที่ api ให้แล้ว → ไม่มี CORS, cookie เป็น SameSite=Strict ได้
VITE_API_BASE_URL=/api/v1
VITE_HUB_URL=/hubs/doc
