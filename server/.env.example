# ═══════════════════════════════════════════════════════════════════════════
#  cp .env.example .env  แล้วเติมรหัสผ่านให้ตรงกับ ../.env ของ docker compose
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=5081

# ─────────────────────────────────────────────────────────────────────────
#  ⚠️ สอง URL นี้ต้องเป็นคนละบัญชี และนี่ไม่ใช่เรื่องความสะอาดของโค้ด
#
#  DATABASE_URL       runtime ใช้   → pm_app (ไม่ใช่ owner, ไม่มี BYPASSRLS)
#  DATABASE_ADMIN_URL migration ใช้ → postgres (owner)
#
#  ถ้า runtime ต่อด้วย postgres RLS policy ทุกข้อจะถูกข้าม **โดยไม่มีอาการ
#  อะไรเลย** ทุก query คืนข้อมูลครบ ทุกเทสที่ใช้ workspace เดียวผ่านหมด แล้ว
#  ข้อมูลข้าม workspace จะโผล่ให้เห็นก็ต่อเมื่อมีลูกค้าที่สอง
#
#  DbService ตรวจข้อนี้ตอนบูตและปฏิเสธที่จะขึ้นถ้า role ผิด
# ─────────────────────────────────────────────────────────────────────────

# รหัสผ่านของ pm_app ตั้งเองได้อิสระ — db:setup จะสร้าง/ปรับ role ให้ตรงกับค่านี้
DATABASE_URL=postgres://pm_app:CHANGE_ME_app_password@localhost:5440/projectmanagement

# ต้องตรงกับ POSTGRES_USER / POSTGRES_PASSWORD ใน ../.env
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5440/projectmanagement

DATABASE_POOL_MAX=10

# ─────────────────────────────────────────────────────────────────────────
#  ต้องตรงกับ JWT_* ใน ../.env (ค่าเดียวกับที่ฝั่ง .NET ใช้)
#  ⚠️ อย่างน้อย 32 ไบต์ — สร้างใหม่: openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_at_least_32_bytes_long_secret_key
JWT_ISSUER=ProjectManagementAPI
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

WEB_ORIGIN=http://localhost
