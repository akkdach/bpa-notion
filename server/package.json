{
  "name": "projectmanagement-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "check:arch": "node scripts/check-architecture.mjs",
    "//check": "ทุกอย่างที่ CI รัน — รันตัวนี้ก่อน push",
    "check": "npm run typecheck && npm run check:arch && npm run lint && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "//db:setup": "migrate + sql/objects.sql + สร้าง role pm_app — รันซ้ำได้เสมอ",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@blocknote/core": "^0.52.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.0",
    "linkedom": "^0.18.13",
    "pg": "^8.13.1",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.32",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.0",
    "eslint": "^10.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "unplugin-swc": "^1.5.10",
    "vitest": "^2.1.8"
