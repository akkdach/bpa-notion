# ═══════════════════════════════════════════════════════════
.idea/
*.swp
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code: keep shared settings, ignore personal ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code: keep the shared skill, ignore per-machine permissions
.claude/settings.local.json
