# ═══════════════════════════════════════════════════════════
node_modules/
dist/
dist-ssr/
*.local
.vite/
playwright-report/
test-results/
blob-report/
.playwright/

# ═══════════════════════════════════════════════════════════
#  Secrets — .env.example is the only env file that is tracked
# ═══════════════════════════════════════════════════════════
.env
.env.uat
.env.production
.env.*.local
!.env.example
!web/.env
!web/.env.uat
!web/.env.production

# ═══════════════════════════════════════════════════════════
#  Runtime artefacts
# ═══════════════════════════════════════════════════════════
backups/
uploads/

