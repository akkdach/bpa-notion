# ═══════════════════════════════════════════════════════════════════════════
#  Production — same-origin ผ่าน nginx (ดู web/nginx.conf)
#
#  ถ้าวันหนึ่ง web กับ api อยู่คนละ host ให้เปลี่ยนเป็น absolute URL แล้ว
#  ต้องกลับไปตั้ง Cors:AllowedOrigins ฝั่ง API ให้ตรงด้วย
# ═══════════════════════════════════════════════════════════════════════════
VITE_API_BASE_URL=/api/v1
VITE_HUB_URL=/hubs/doc
